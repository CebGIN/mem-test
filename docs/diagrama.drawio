        <mxCell id="ley-label-composition" value="&lt;b&gt;Composición&lt;/b&gt;&lt;br&gt;El todo posee la parte y controla su ciclo de vida." style="text;html=1;whiteSpace=wrap;overflow=visible;rounded=0;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1" data-check="skip">
