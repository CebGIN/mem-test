        <mxCell id="ley-shapes" value="&lt;b&gt;Componente&lt;/b&gt;: módulo con el icono UML a la izquierda. &lt;b&gt;Estado&lt;/b&gt;: rectángulo redondeado. &lt;b&gt;Inicial&lt;/b&gt;: círculo negro. &lt;b&gt;Final&lt;/b&gt;: círculo doble." style="text;html=1;whiteSpace=wrap;overflow=visible;rounded=0;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1" data-check="skip">
